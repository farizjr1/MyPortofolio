# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development

# ─── MongoDB ─────────────────────────────────────────────────────────────────
# For local development: leave blank to use in-memory MongoDB (auto-starts)
# For production: use a MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority

# ─── JWT Auth ─────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Email (Nodemailer) ──────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=your-email@gmail.com

# ─── Frontend ────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8080/api

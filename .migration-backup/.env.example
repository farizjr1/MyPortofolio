# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development

# ─── MongoDB ─────────────────────────────────────────────────────────────────
# Biarkan kosong untuk pakai in-memory MongoDB (data hilang saat restart)
# Isi dengan URI Atlas untuk data permanen di production
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority

# ─── JWT Auth ─────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# ─── Session ─────────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-another-random-string

# ─── CORS ────────────────────────────────────────────────────────────────────
# URL frontend yang diizinkan — TANPA trailing slash
CORS_ORIGIN=http://localhost:5173

# ─── Email / SMTP (Nodemailer + Gmail) ───────────────────────────────────────
# Digunakan untuk:
#   • Verifikasi email saat register
#   • Kirim link reset password
#   • Notifikasi pesan dari form Contact
#
# Cara setup Gmail App Password:
#   1. Aktifkan 2FA: https://myaccount.google.com/security
#   2. Buat App Password: https://myaccount.google.com/apppasswords
#      → App: Mail  → Device: Other → nama bebas → Generate
#   3. Salin 16-karakter yang muncul → isi di SMTP_APP_PASSWORD (tanpa spasi)
#
SMTP_EMAIL=your-gmail@gmail.com
SMTP_APP_PASSWORD=abcdefghijklmnop
CONTACT_TO_EMAIL=your-gmail@gmail.com

# ─── Frontend ────────────────────────────────────────────────────────────────
# Digunakan saat frontend di-deploy di Vercel (terpisah dari backend di Railway)
# Isi dengan URL Railway backend kamu — TANPA trailing slash
# Contoh: VITE_API_URL=https://myportofolio-api.railway.app
# Di Replit: tidak perlu diset — URL relatif /api/... sudah ditangani proxy
VITE_API_URL=
